{
  "name": "whatsappweb",
  "productName": "WhatsApp Web",
  "version": "0.2.0",
  "description": "Multi-account WhatsApp Web desktop client",
  "desktopName": "com.whatsappweb.WhatsAppWeb.desktop",
  "main": "src/main/main.js",
  "author": "Njobvu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "node scripts/gen-icon.js && electron-builder --linux AppImage",
